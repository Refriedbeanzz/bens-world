{
  "name": "bens-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "stress": "esbuild scripts/stress.ts --bundle --format=esm --platform=node --outfile=node_modules/.tmp/stress.mjs && node node_modules/.tmp/stress.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
